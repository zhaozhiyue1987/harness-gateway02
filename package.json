{
  "name": "dsh-higress-credential-routes-plugin",
  "version": "0.1.0",
  "description": "Harness bundle that discovers Higress AI routes authorized by one or more gateway credentials",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhaozhiyue1987/harness-gateway02.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.0 <0.3.0"
  },
  "main": "dist/host/index.js",
  "types": "dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./shared": {
      "types": "./dist/shared/contracts.d.ts",
      "default": "./dist/shared/contracts.js"
    },
    "./typert": {
      "types": "./dist/typert.host.d.ts",
      "default": "./dist/typert.host.js"
    },
    "./remote": {
      "types": "./dist/typert.remote-client.d.ts",
      "default": "./dist/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "DEPLOYMENT.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.0",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "react": ">=18.2.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0",
    "zod": "^4.4.3"
  }
}
